rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function myEmail() { return request.auth.token.email; }

    // Email superadmin awal — HARUS sama dengan SUPERADMIN_EMAIL di firebase-config.js.
    // Hanya dipakai sekali (saat bootstrap); setelah itu hak admin terikat ke UID.
    function bootstrapEmail() { return 'asdf@asdf.com'; }

    // ---------- superadmin ----------
    // meta/admin mengunci bootstrap supaya hanya bisa terjadi satu kali.
    match /meta/admin {
      allow read: if signedIn();
      allow create: if signedIn()
        && myEmail().lower() == bootstrapEmail()
        && request.resource.data.uid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update, delete: if false;
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && myEmail().lower() == bootstrapEmail()
        && !exists(/databases/$(database)/documents/meta/admin)
        && getAfter(/databases/$(database)/documents/meta/admin).data.uid == uid;
      allow update, delete: if false;
    }

    // ---------- anggota (data privat: email) ----------
    match /members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'createdAt'])
        && request.resource.data.email == myEmail()
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.createdAt == request.time;
      // Pemilik hanya boleh memperbarui email, status verifikasi & waktu login terakhir
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'emailVerified', 'lastLoginAt'])
        && request.resource.data.email == myEmail()
        && request.resource.data.get('emailVerified', false) is bool
        && (!('lastLoginAt' in request.resource.data) || request.resource.data.lastLoginAt is timestamp);
      allow delete: if isAdmin();
    }

    // ---------- notifikasi pendaftaran untuk superadmin ----------
    // ID dokumen = UID pendaftar, jadi satu akun hanya bisa membuat satu notifikasi.
    match /notifications/{uid} {
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['type', 'uid', 'email', 'name', 'read', 'createdAt'])
        && request.resource.data.type == 'signup'
        && request.resource.data.uid == uid
        && request.resource.data.email == myEmail()
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;
    }

    // ---------- username unik ----------
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn()
        && name.matches('^[a-z0-9_.]{2,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == name;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- profil publik ----------
    match /users/{uid} {
      allow read: if true;

      function okUrl(u) {
        return u is string && u.size() <= 500 && (u == '' || u.matches('^https?://.+'));
      }
      function validProfile(d) {
        return d.keys().hasOnly(['username', 'displayName', 'bio', 'avatar', 'accent', 'bg', 'links', 'views',
                                 'createdAt', 'badges', 'bgVideo', 'bgVideoPath', 'bgBlur'])
          && d.displayName is string && d.displayName.size() <= 40
          && d.bio is string && d.bio.size() <= 160
          && okUrl(d.avatar) && okUrl(d.bg)
          && d.accent is string && d.accent.matches('^#[0-9a-fA-F]{6}$')
          && d.links is list && d.links.size() <= 20
          && d.get('badges', []) is list && d.get('badges', []).size() <= 12
          && d.get('bgBlur', 6) is number && d.get('bgBlur', 6) >= 0 && d.get('bgBlur', 6) <= 20
          // video hanya boleh dari Firebase Storage milik sendiri
          && (d.get('bgVideo', '') == '' || d.get('bgVideo', '').matches('^https://firebasestorage[.]googleapis[.]com/.+'))
          && (d.get('bgVideoPath', '') == '' || d.get('bgVideoPath', '').matches('^videos/' + uid + '/[^/]+$'));
      }

      allow create: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.views == 0
        && request.resource.data.get('badges', []).size() == 0
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;

      allow update:
        // Pemilik: tidak boleh mengubah username, views, maupun badge
        if (signedIn() && request.auth.uid == uid
            && request.resource.data.username == resource.data.username
            && request.resource.data.views == resource.data.views
            && request.resource.data.get('badges', []) == resource.data.get('badges', [])
            && validProfile(request.resource.data))
        // Superadmin: hanya boleh mengubah badge
        || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['badges'])
            && request.resource.data.badges is list && request.resource.data.badges.size() <= 12)
        // Pengunjung: hanya +1 views
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
            && request.resource.data.views == resource.data.views + 1);

      allow delete: if isAdmin();
    }

    // ---------- pengaturan situs (tema & logo) — hanya superadmin ----------
    match /settings/site {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['theme', 'logo', 'updatedAt'])
        && request.resource.data.get('theme', 'nebula') in ['nebula', 'aurora', 'inferno', 'frost']
        && request.resource.data.get('logo', '') is string
        && request.resource.data.get('logo', '').size() < 400000
        && (request.resource.data.get('logo', '') == ''
            || request.resource.data.get('logo', '').matches('^data:image/(png|jpeg|webp|svg[+]xml);base64,.+'));
    }

    // ---------- permintaan reset password (ID = email huruf kecil) ----------
    // Bisa dibuat tanpa login (anggota yang lupa password). Hanya superadmin yang bisa membaca.
    match /resetRequests/{email} {
      function validRequest(d) {
        return d.keys().hasOnly(['email', 'note', 'status', 'createdAt'])
          && d.email == email
          && email.matches('^[^@/ ]{1,64}@[^@/ ]{1,190}[.][a-z]{2,24}$')
          && d.note is string && d.note.size() <= 200
          && d.status == 'pending'
          && d.createdAt == request.time;
      }
      allow read, delete: if isAdmin();
      allow create: if validRequest(request.resource.data);
      allow update: if (resource.data.status == 'done' && validRequest(request.resource.data))
        || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'handledAt'])
            && request.resource.data.status == 'done');
    }

    // ---------- log aktivitas ----------
    match /activity/{id} {
      allow read, delete: if isAdmin();
      allow update: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'event', 'device', 'os', 'browser', 'tz', 'region', 'lang', 'screen', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.event in ['signup', 'login', 'logout', 'password_change', 'email_change', 'profile_save',
                                           'video_upload', 'site_settings', 'badge_update', 'admin_reset_sent']
        && request.resource.data.device is string && request.resource.data.device.size() <= 40
        && request.resource.data.os is string && request.resource.data.os.size() <= 40
        && request.resource.data.browser is string && request.resource.data.browser.size() <= 40
        && request.resource.data.tz is string && request.resource.data.tz.size() <= 60
        && request.resource.data.region is string && request.resource.data.region.size() <= 60
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 20
        && request.resource.data.screen is string && request.resource.data.screen.size() <= 20
        && request.resource.data.at == request.time;
    }
  }
}
